    display.println(F("ENTER PROFILE NAME:")); 
    display.println(F(" Joy Y: Change Ltr")); 
    display.println(F(" Joy X: Move Cursor")); 
    display.println();
    
    display.setCursor(4, 40); display.setTextSize(2);
    for(int i=0; i<10; i++) {
      if(i == textCursor) display.setTextColor(SSD1306_BLACK, SSD1306_WHITE); 
      else display.setTextColor(SSD1306_WHITE, SSD1306_BLACK); 
      
      if(textBuffer[i] == ' ' && i != textCursor) display.print('_'); 
