// ==========================================
void setup() {
  Serial.begin(115200);

  for (int i = 0; i < 13; i++) {
    pinMode(buttonPins[i], INPUT_PULLUP);
    buttonStates[i] = false; lastButtonStates[i] = false;
  }

  // --- NVS CORRUPTION REPAIR ---
  esp_err_t err = nvs_flash_init();
  if (err == ESP_ERR_NVS_NO_FREE_PAGES || err == ESP_ERR_NVS_NEW_VERSION_FOUND) {
    nvs_flash_erase();
    nvs_flash_init();
  }

  // Read System Variables
  preferences.begin("sys", true);
  conf_use_ble = preferences.getBool("ble", false);
  conf_boot_logo = preferences.getUChar("bootlogo", 0);
  conf_boot_invert = preferences.getBool("bootinv", false);
  BTN_IDX_OK = preferences.getInt("btnok", 10);
  BTN_IDX_BACK = preferences.getInt("btnback", 11);
  uint8_t current_cycle_idx = preferences.getUChar("bootcyc", 0);
  
  for(int i=0; i<MAX_PROFS; i++) {
    String key = "n" + String(i);
    profNames[i] = preferences.getString(key.c_str(), "");
  }
  preferences.end();

  loadConfigFromSlot("default");

  Wire.begin(8, 9);
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { for(;;); }
  
  // --- THE BOOT SEQUENCE ---
  uint8_t display_mode = conf_boot_logo;
  if (display_mode == 6) { 
    display_mode = current_cycle_idx;
    current_cycle_idx++;
    if (current_cycle_idx > 4) current_cycle_idx = 0;
    preferences.begin("sys", false);
    preferences.putUChar("bootcyc", current_cycle_idx);
    preferences.end();
  }

  display.clearDisplay(); 
  uint16_t fg = conf_boot_invert ? SSD1306_BLACK : SSD1306_WHITE;
  uint16_t bg = conf_boot_invert ? SSD1306_WHITE : SSD1306_BLACK;
  if (conf_boot_invert) display.fillScreen(SSD1306_WHITE);

  if (display_mode == 0) { display.drawBitmap(0, 0, bootLogoBitmap, 128, 64, fg); } 
  else if (display_mode == 1) { display.drawBitmap(0, 0, epd_bitmap_missilis1, 128, 64, fg); }
  else if (display_mode == 2) { display.drawBitmap(0, 0, epd_bitmap_Faction_Marcel_Group_Icon123, 128, 64, fg); }
  else if (display_mode == 3) { display.drawBitmap(0, 0, epd_bitmap_download128, 128, 64, fg); }
  else if (display_mode == 4) { display.drawBitmap(0, 0, epd_bitmap_images123456, 128, 64, fg); }
  else if (display_mode == 5) {
    display.setTextColor(fg, bg); display.setTextSize(2);
    display.setCursor(10, 20); display.println(F("OS BOOTING")); 
  }
  display.display(); 
  delay(1500); 

  if (conf_use_ble) {
    bleGamepad.begin();
  } else {
    Mouse.begin(); Gamepad.begin(); Keyboard.begin(); USB.begin();
    Gamepad.send(0, 0, 0, 0, 0, 0, 0, 0);
  }
}

void loop() {
  for (int i = 0; i < 13; i++) buttonStates[i] = (digitalRead(buttonPins[i]) == LOW);

  if (buttonStates[BTN_IDX_MENU_1] && buttonStates[BTN_IDX_MENU_2]) {
    switchMode(MODE_MENU);
  }

  switch (currentMode) {
    case MODE_MENU:    handleMenu(); break;
    case MODE_GAMEPAD: handleGamepad(); break;
    case MODE_MOUSE:   handleMouse(); break;
    case MODE_TESTER:  handleTester(); break; 
  }

  for (int i = 0; i < 13; i++) lastButtonStates[i] = buttonStates[i];
  delay(10); 
}

// ==========================================
// SMART MODE SWITCHING
// ==========================================
void switchMode(Mode newMode) {
  if (currentMode == newMode) return;

  // RELEASE ALL STATES BEFORE SWITCHING TO PREVENT ZZZ FILTER CRASH
  if (!conf_use_ble) {
    Keyboard.releaseAll();
    Mouse.release(MOUSE_LEFT); Mouse.release(MOUSE_RIGHT); Mouse.release(MOUSE_MIDDLE);
    Gamepad.send(0, 0, 0, 0, 0, 0, 0, 0); // Send ONE single zero report
  } else {
    if (bleGamepad.isConnected()) {
      bleGamepad.setLeftThumb(0, 0);
      bleGamepad.setRightThumb(0, 0);
      bleGamepad.setLeftTrigger(0);
      bleGamepad.setRightTrigger(0);
      bleGamepad.setHat1(0);
      for (int i = 1; i <= 16; i++) bleGamepad.release(i);
    }
  }

  // Force Gamepad Engine to send immediately on next boot
  last_gp_j1x=0; last_gp_j1y=0; last_gp_j2x=0; last_gp_j2y=0;
  last_gp_trigL=0; last_gp_trigR=0; last_gp_hat=0; last_gp_btn=0;

  currentMode = newMode;
  isEditing = false;
  scrollIndex = 0;
  lastOledUpdate = 0; // Force immediate screen refresh

  if (newMode == MODE_MENU) {
    currentCat = CAT_MAIN;
  }
}

