void applySaneDefaults() {
  gp_map_idx[0] = 1; gp_map_idx[1] = 2; gp_map_idx[2] = 3; gp_map_idx[3] = 4;
  gp_map_idx[4] = 5; gp_map_idx[5] = 6; gp_map_idx[6] = 14; gp_map_idx[7] = 15;
  gp_map_idx[8] = 16; gp_map_idx[9] = 11; gp_map_idx[10] = 9; gp_map_idx[11] = 10; gp_map_idx[12] = 17;
  
  kb_map_idx[0] = 49; kb_map_idx[1] = 50; kb_map_idx[2] = 37; kb_map_idx[3] = 18;
  kb_map_idx[4] = 0; kb_map_idx[5] = 6; kb_map_idx[6] = 17; kb_map_idx[7] = 5;
  kb_map_idx[8] = 38; kb_map_idx[9] = 0; kb_map_idx[10] = 24; kb_map_idx[11] = 25; kb_map_idx[12] = 39;

  j1x_center=2048; j1y_center=2048; j2x_center=2048; j2y_center=2048;
  conf_deadzone=150; conf_mouse_sens=5; conf_mouse_accel=1.8;
  gp_j1_swap=false; gp_j1_invX=false; gp_j1_invY=false; gp_j2_swap=false; gp_j2_invX=false; gp_j2_invY=false;
  gp_j1_mode=0; gp_j2_mode=1;
  mk_j1_swap=false; mk_j1_invX=false; mk_j1_invY=false; mk_j2_swap=false; mk_j2_invX=false; mk_j2_invY=false; mk_j2_mode=2; // Default WASD
}

void loadConfigFromSlot(String slot) {
  preferences.begin(slot.c_str(), true);
  size_t testLen = preferences.getBytes("gpmap", gp_map_idx, 13);
  
  if (testLen == 0) {
    applySaneDefaults();
  } else {
    preferences.getBytes("kbmap", kb_map_idx, 13);
    j1x_center = preferences.getInt("j1xc", 2048); j1y_center = preferences.getInt("j1yc", 2048);
    j2x_center = preferences.getInt("j2xc", 2048); j2y_center = preferences.getInt("j2yc", 2048);
    conf_deadzone = preferences.getInt("dz", 150);
    conf_mouse_sens = preferences.getInt("msens", 5); conf_mouse_accel = preferences.getFloat("maccel", 1.8);
    
    gp_j1_swap = preferences.getBool("g1s", false); gp_j1_invX = preferences.getBool("g1ix", false); gp_j1_invY = preferences.getBool("g1iy", false);
    gp_j2_swap = preferences.getBool("g2s", false); gp_j2_invX = preferences.getBool("g2ix", false); gp_j2_invY = preferences.getBool("g2iy", false);
    gp_j1_mode = preferences.getUChar("g1m", 0); gp_j2_mode = preferences.getUChar("g2m", 1);
    
    mk_j1_swap = preferences.getBool("m1s", false); mk_j1_invX = preferences.getBool("m1ix", false); mk_j1_invY = preferences.getBool("m1iy", false);
    mk_j2_swap = preferences.getBool("m2s", false); mk_j2_invX = preferences.getBool("m2ix", false); mk_j2_invY = preferences.getBool("m2iy", false);
    mk_j2_mode = preferences.getUChar("m2m", 2); 
  }
  preferences.end();
}

void saveConfigToSlot(String slot) {
  preferences.begin(slot.c_str(), false);
  preferences.putBytes("gpmap", gp_map_idx, 13); preferences.putBytes("kbmap", kb_map_idx, 13);
  preferences.putInt("j1xc", j1x_center); preferences.putInt("j1yc", j1y_center);
  preferences.putInt("j2xc", j2x_center); preferences.putInt("j2yc", j2y_center);
  preferences.putInt("dz", conf_deadzone);
  preferences.putInt("msens", conf_mouse_sens); preferences.putFloat("maccel", conf_mouse_accel);
  
  preferences.putBool("g1s", gp_j1_swap); preferences.putBool("g1ix", gp_j1_invX); preferences.putBool("g1iy", gp_j1_invY);
  preferences.putBool("g2s", gp_j2_swap); preferences.putBool("g2ix", gp_j2_invX); preferences.putBool("g2iy", gp_j2_invY);
  preferences.putUChar("g1m", gp_j1_mode); preferences.putUChar("g2m", gp_j2_mode);
  
  preferences.putBool("m1s", mk_j1_swap); preferences.putBool("m1ix", mk_j1_invX); preferences.putBool("m1iy", mk_j1_invY);
  preferences.putBool("m2s", mk_j2_swap); preferences.putBool("m2ix", mk_j2_invX); preferences.putBool("m2iy", mk_j2_invY);
  preferences.putUChar("m2m", mk_j2_mode);
  preferences.end();
}

void saveProfileName(int idx, String name) {
  profNames[idx] = name;
  preferences.begin("sys", false); String key = "n" + String(idx);
  preferences.putString(key.c_str(), name); preferences.end();
}

void resetToDefaults() {
  applySaneDefaults();
  saveConfigToSlot("default");
}

int getFirstEmptyProfileSlot() {
  for(int i=0; i<MAX_PROFS; i++) if(profNames[i] == "") return i;
  return -1;
}

// ==========================================
// CORE HARDWARE MATH
// ==========================================
void calibrateSticks() {
  display.clearDisplay(); display.setTextSize(1); display.setCursor(0, 20);
  display.println(F("Leave sticks neutral!")); display.println(F("Calibrating in 1s...")); display.display(); delay(1000);
  long s_j1x = 0, s_j1y = 0, s_j2x = 0, s_j2y = 0; int samples = 50;
  for(int i=0; i<samples; i++) {
    s_j1x += analogRead(JOY1_X); s_j1y += analogRead(JOY1_Y); s_j2x += analogRead(JOY2_X); s_j2y += analogRead(JOY2_Y); delay(10);
  }
  j1x_center = s_j1x / samples; j1y_center = s_j1y / samples; j2x_center = s_j2x / samples; j2y_center = s_j2y / samples;
  saveConfigToSlot("default");
  display.clearDisplay(); display.setCursor(0, 20); display.println(F("Done & Saved!")); display.display(); delay(1000);
}

int8_t processAxis(int rawValue, int centerValue, bool invert) {
  int diff = rawValue - centerValue; if (abs(diff) < conf_deadzone) return 0;
  float scaled = (diff > 0) ? (float)(diff - conf_deadzone) / (4095 - centerValue - conf_deadzone) * 127.0 : (float)(diff + conf_deadzone) / (centerValue - conf_deadzone) * 127.0;
  int finalVal = constrain((int)scaled, -127, 127); return (int8_t)(invert ? -finalVal : finalVal);
}

void getJoystickStates(int8_t &outJ1X, int8_t &outJ1Y, int8_t &outJ2X, int8_t &outJ2Y, bool isGamepad) {
  bool s1 = isGamepad ? gp_j1_swap : mk_j1_swap;
  bool ix1 = isGamepad ? gp_j1_invX : mk_j1_invX;
  bool iy1 = isGamepad ? gp_j1_invY : mk_j1_invY;
  bool s2 = isGamepad ? gp_j2_swap : mk_j2_swap;
  bool ix2 = isGamepad ? gp_j2_invX : mk_j2_invX;
  bool iy2 = isGamepad ? gp_j2_invY : mk_j2_invY;

  int8_t j1x = processAxis(analogRead(JOY1_X), j1x_center, ix1); int8_t j1y = processAxis(analogRead(JOY1_Y), j1y_center, iy1);
  int8_t j2x = processAxis(analogRead(JOY2_X), j2x_center, ix2); int8_t j2y = processAxis(analogRead(JOY2_Y), j2y_center, iy2);
  outJ1X = s1 ? j1y : j1x; outJ1Y = s1 ? j1x : j1y; outJ2X = s2 ? j2y : j2x; outJ2Y = s2 ? j2x : j2y;
}

// ==========================================
// TEXT EDITOR ENGINE 
// ==========================================
void openTextEditor(MenuCat retCat, const char* preloadName) {
  returnCat = retCat; currentCat = CAT_TEXT_ENTRY; textCursor = 0;
  for(int i=0; i<10; i++) textBuffer[i] = ' '; textBuffer[10] = '\0';
  int len = String(preloadName).length();
  for(int i=0; i<len && i<10; i++) textBuffer[i] = preloadName[i];
  if(textBuffer[0] == ' ') textBuffer[0] = 'A'; 
}

void handleTextEditor(int8_t j1x, int8_t j1y) {
  if (millis() - lastScrollTime > SCROLL_DELAY) {
    if (j1y > 64 || j1y < -64) {
      char curr = textBuffer[textCursor]; 
      int cIdx = 0;
      for(int i=0; i<charsetLen; i++) { if(charset[i] == curr) { cIdx = i; break; } }
      if (j1y < -64) cIdx++; else cIdx--;
      
      if (cIdx < 0) cIdx = charsetLen - 1; 
      if (cIdx >= charsetLen) cIdx = 0;
      textBuffer[textCursor] = charset[cIdx]; 
      lastScrollTime = millis();
    }
  }
  
  if (millis() - lastXScrollTime > SCROLL_DELAY) {
    if (j1x > 64 || j1x < -64) {
      if (j1x > 64) { textCursor++; if(textCursor > 9) textCursor = 0; } 
      if (j1x < -64) { textCursor--; if(textCursor < 0) textCursor = 9; } 
      lastXScrollTime = millis();
    }
  }

  if (btnPressed(BTN_IDX_OK)) {
    String finalName = String(textBuffer); finalName.trim();
    if(finalName == "") finalName = "PROFILE";
    saveProfileName(targetProfileSlot, finalName);
    saveConfigToSlot("p" + String(targetProfileSlot));
    currentCat = returnCat; scrollIndex = 0; targetProfileSlot = -1;
  }
  if (btnPressed(BTN_IDX_BACK)) { currentCat = returnCat; scrollIndex = 0; targetProfileSlot = -1; }
}

// ==========================================
// OS MENU NAVIGATION SYSTEM
// ==========================================
bool btnPressed(int idx) { return (buttonStates[idx] && !lastButtonStates[idx]); }

void handleMenu() {
  int8_t j1x, j1y, j2x, j2y;
  getJoystickStates(j1x, j1y, j2x, j2y, true); 

  if (currentCat == CAT_TEXT_ENTRY) { 
    handleTextEditor(j1x, j1y); 
    updateOLED(); 
    return; 
  }

  int listSize = 0;
  if (currentCat == CAT_MAIN) listSize = 9; 
  else if (currentCat == CAT_GP_MENU) listSize = 3;
  else if (currentCat == CAT_MK_MENU) listSize = 4;
  else if (currentCat == CAT_PROFILES) listSize = 5;
  else if (currentCat == CAT_PROF_SAVE_OPT) listSize = 2;
  else if (currentCat == CAT_LIST_LOAD || currentCat == CAT_LIST_OVERWRITE || currentCat == CAT_LIST_RENAME || currentCat == CAT_LIST_DELETE) listSize = 10;
  else if (currentCat == CAT_GP_MAP || currentCat == CAT_KB_MAP) listSize = 13;
  else if (currentCat == CAT_GP_J1 || currentCat == CAT_GP_J2 || currentCat == CAT_MK_J2) listSize = 4; 
  else if (currentCat == CAT_MK_J1 || currentCat == CAT_MOUSE_CFG) listSize = 3;
  else if (currentCat == CAT_SYS_CFG) listSize = 5;

  if (millis() - lastScrollTime > SCROLL_DELAY) {
    if (!isEditing) {
      if (j1y > 64) { scrollIndex++; lastScrollTime = millis(); }
      if (j1y < -64) { scrollIndex--; lastScrollTime = millis(); }
      if (scrollIndex < 0) scrollIndex = listSize - 1;
      if (scrollIndex >= listSize) scrollIndex = 0;
    } else {
      if (j1x > 64) { editValue++; lastScrollTime = millis(); }
      if (j1x < -64) { editValue--; lastScrollTime = millis(); }
      
      if (currentCat == CAT_GP_MAP) { if(editValue < 0) editValue = NUM_GP_OPTS-1; if(editValue >= NUM_GP_OPTS) editValue = 0; }
      else if (currentCat == CAT_KB_MAP) { if(editValue < 0) editValue = NUM_KB_OPTS-1; if(editValue >= NUM_KB_OPTS) editValue = 0; }
      else if (currentCat == CAT_GP_J1 && scrollIndex == 3) { if(editValue < 0) editValue = 2; if(editValue > 2) editValue = 0; }
      else if (currentCat == CAT_GP_J2 && scrollIndex == 3) { if(editValue < 0) editValue = 2; if(editValue > 2) editValue = 0; }
      else if (currentCat == CAT_MK_J2 && scrollIndex == 3) { if(editValue < 0) editValue = 2; if(editValue > 2) editValue = 0; } 
      else if (currentCat == CAT_MOUSE_CFG) {
        if(scrollIndex==0) { if(editValue < 1) editValue=20; if(editValue > 20) editValue=1; }
        if(scrollIndex==1) { if(editValue < 10) editValue=30; if(editValue > 30) editValue=10; } 
        if(scrollIndex==2) { if(editValue < 50) editValue=500; if(editValue > 500) editValue=50; }
      }
      else if (currentCat == CAT_SYS_CFG) { 
        if(scrollIndex == 0) { if(editValue < 0) editValue = 6; if(editValue > 6) editValue = 0; } 
        if(scrollIndex == 1) { if(editValue < 0) editValue = 1; if(editValue > 1) editValue = 0; } 
        if(scrollIndex == 2) { if(editValue < 0) editValue = 12; if(editValue > 12) editValue = 0; } 
        if(scrollIndex == 3) { if(editValue < 0) editValue = 12; if(editValue > 12) editValue = 0; } 
        if(scrollIndex == 4) { if(editValue < 0) editValue = 1; if(editValue > 1) editValue = 0; } 
      } 
      else { if(editValue < 0) editValue = 1; if(editValue > 1) editValue = 0; }
    }
  }

  if (btnPressed(BTN_IDX_OK)) {
    if (!isEditing) {
      if (currentCat == CAT_MAIN) {
        if (scrollIndex == 0) switchMode(MODE_GAMEPAD);
        else if (scrollIndex == 1) switchMode(MODE_MOUSE);
        else if (scrollIndex == 2) calibrateSticks();
        else if (scrollIndex == 3) {
          conf_use_ble = !conf_use_ble;
          preferences.begin("sys", false); preferences.putBool("ble", conf_use_ble); preferences.end();
          display.clearDisplay(); display.setTextColor(SSD1306_WHITE); display.setTextSize(2); 
          display.setCursor(10, 20); display.print(F("REBOOTING")); display.display();
          delay(1000); ESP.restart(); 
        }
        else if (scrollIndex == 4) { currentCat = CAT_PROFILES; scrollIndex = 0; }
        else if (scrollIndex == 5) { currentCat = CAT_GP_MENU; scrollIndex = 0; }
        else if (scrollIndex == 6) { currentCat = CAT_MK_MENU; scrollIndex = 0; }
        else if (scrollIndex == 7) { currentCat = CAT_SYS_CFG; scrollIndex = 0; }
        else if (scrollIndex == 8) { switchMode(MODE_TESTER); } 
      } 
      else if (currentCat == CAT_GP_MENU) {
        if(scrollIndex == 0) { currentCat = CAT_GP_MAP; scrollIndex = 0; }
        else if(scrollIndex == 1) { currentCat = CAT_GP_J1; scrollIndex = 0; }
        else if(scrollIndex == 2) { currentCat = CAT_GP_J2; scrollIndex = 0; }
      }
      else if (currentCat == CAT_MK_MENU) {
        if(scrollIndex == 0) { currentCat = CAT_KB_MAP; scrollIndex = 0; }
        else if(scrollIndex == 1) { currentCat = CAT_MK_J1; scrollIndex = 0; }
        else if(scrollIndex == 2) { currentCat = CAT_MK_J2; scrollIndex = 0; }
        else if(scrollIndex == 3) { currentCat = CAT_MOUSE_CFG; scrollIndex = 0; }
      }
      else if (currentCat == CAT_PROFILES) {
        if (scrollIndex == 0) { currentCat = CAT_LIST_LOAD; scrollIndex = 0; }
        else if (scrollIndex == 1) { 
          targetProfileSlot = getFirstEmptyProfileSlot();
          if(targetProfileSlot != -1) openTextEditor(CAT_PROFILES, ""); 
        }
        else if (scrollIndex == 2) { currentCat = CAT_PROF_SAVE_OPT; scrollIndex = 0; }
        else if (scrollIndex == 3) { currentCat = CAT_LIST_RENAME; scrollIndex = 0; }
        else if (scrollIndex == 4) { currentCat = CAT_LIST_DELETE; scrollIndex = 0; }
      }
      else if (currentCat == CAT_PROF_SAVE_OPT) {
        if (scrollIndex == 0) { currentCat = CAT_LIST_OVERWRITE; scrollIndex = 0; }
        else if (scrollIndex == 1) {
          targetProfileSlot = getFirstEmptyProfileSlot();
          if(targetProfileSlot != -1) openTextEditor(CAT_PROFILES, "");
        }
      }
      else if (currentCat == CAT_LIST_LOAD || currentCat == CAT_LIST_OVERWRITE || currentCat == CAT_LIST_RENAME || currentCat == CAT_LIST_DELETE) {
        if (profNames[scrollIndex] != "" || currentCat == CAT_LIST_OVERWRITE) {
          if (currentCat == CAT_LIST_LOAD) {
             loadConfigFromSlot("p" + String(scrollIndex)); saveConfigToSlot("default");
             currentCat = CAT_PROFILES; scrollIndex = 0;
          }
          else if (currentCat == CAT_LIST_OVERWRITE) {
             saveConfigToSlot("p" + String(scrollIndex));
             if(profNames[scrollIndex] == "") openTextEditor(CAT_PROFILES, "");
             else { currentCat = CAT_PROFILES; scrollIndex = 0; }
          }
          else if (currentCat == CAT_LIST_RENAME) {
             targetProfileSlot = scrollIndex; openTextEditor(CAT_PROFILES, profNames[scrollIndex].c_str());
          }
          else if (currentCat == CAT_LIST_DELETE) {
             saveProfileName(scrollIndex, ""); currentCat = CAT_PROFILES; scrollIndex = 0;
          }
        }
      }
      else {
        isEditing = true;
        if (currentCat == CAT_GP_MAP) editValue = gp_map_idx[scrollIndex];
        else if (currentCat == CAT_KB_MAP) editValue = kb_map_idx[scrollIndex];
        else if (currentCat == CAT_GP_J1) { if(scrollIndex==0) editValue=gp_j1_swap; if(scrollIndex==1) editValue=gp_j1_invX; if(scrollIndex==2) editValue=gp_j1_invY; if(scrollIndex==3) editValue=gp_j1_mode; }
        else if (currentCat == CAT_GP_J2) { if(scrollIndex==0) editValue=gp_j2_swap; if(scrollIndex==1) editValue=gp_j2_invX; if(scrollIndex==2) editValue=gp_j2_invY; if(scrollIndex==3) editValue=gp_j2_mode; }
        else if (currentCat == CAT_MK_J1) { if(scrollIndex==0) editValue=mk_j1_swap; if(scrollIndex==1) editValue=mk_j1_invX; if(scrollIndex==2) editValue=mk_j1_invY; }
        else if (currentCat == CAT_MK_J2) { if(scrollIndex==0) editValue=mk_j2_swap; if(scrollIndex==1) editValue=mk_j2_invX; if(scrollIndex==2) editValue=mk_j2_invY; if (scrollIndex==3) editValue=mk_j2_mode; }
        else if (currentCat == CAT_MOUSE_CFG) { if(scrollIndex==0) editValue=conf_mouse_sens; if(scrollIndex==1) editValue=(int)(conf_mouse_accel*10); if(scrollIndex==2) editValue=conf_deadzone; }
        else if (currentCat == CAT_SYS_CFG) { 
          if(scrollIndex==0) editValue=conf_boot_logo; 
          if(scrollIndex==1) editValue=conf_boot_invert; 
          if(scrollIndex==2) editValue=BTN_IDX_OK;
          if(scrollIndex==3) editValue=BTN_IDX_BACK;
          if(scrollIndex==4) editValue=0; 
        }
      }
    } 
    else {
      isEditing = false;
      if (currentCat == CAT_GP_MAP) gp_map_idx[scrollIndex] = editValue;
      else if (currentCat == CAT_KB_MAP) kb_map_idx[scrollIndex] = editValue;
      else if (currentCat == CAT_GP_J1) { if(scrollIndex==0) gp_j1_swap=editValue; if(scrollIndex==1) gp_j1_invX=editValue; if(scrollIndex==2) gp_j1_invY=editValue; if(scrollIndex==3) gp_j1_mode=editValue; }
      else if (currentCat == CAT_GP_J2) { if(scrollIndex==0) gp_j2_swap=editValue; if(scrollIndex==1) gp_j2_invX=editValue; if(scrollIndex==2) gp_j2_invY=editValue; if(scrollIndex==3) gp_j2_mode=editValue; }
      else if (currentCat == CAT_MK_J1) { if(scrollIndex==0) mk_j1_swap=editValue; if(scrollIndex==1) mk_j1_invX=editValue; if(scrollIndex==2) mk_j1_invY=editValue; }
      else if (currentCat == CAT_MK_J2) { if(scrollIndex==0) mk_j2_swap=editValue; if(scrollIndex==1) mk_j2_invX=editValue; if(scrollIndex==2) mk_j2_invY=editValue; if(scrollIndex==3) mk_j2_mode=editValue; }
      else if (currentCat == CAT_MOUSE_CFG) { if(scrollIndex==0) conf_mouse_sens=editValue; if(scrollIndex==1) conf_mouse_accel=(float)editValue/10.0; if(scrollIndex==2) conf_deadzone=editValue; }
      else if (currentCat == CAT_SYS_CFG) { 
        if(scrollIndex==0) { conf_boot_logo=editValue; preferences.begin("sys", false); preferences.putUChar("bootlogo", conf_boot_logo); preferences.end(); }
        if(scrollIndex==1) { conf_boot_invert=editValue; preferences.begin("sys", false); preferences.putBool("bootinv", conf_boot_invert); preferences.end(); }
        if(scrollIndex==2) { BTN_IDX_OK=editValue; preferences.begin("sys", false); preferences.putInt("btnok", BTN_IDX_OK); preferences.end(); }
        if(scrollIndex==3) { BTN_IDX_BACK=editValue; preferences.begin("sys", false); preferences.putInt("btnback", BTN_IDX_BACK); preferences.end(); }
        if(scrollIndex==4 && editValue==1) { 
          applySaneDefaults(); saveConfigToSlot("default");
          for(int i=0; i<10; i++) saveProfileName(i, ""); 
          display.clearDisplay(); display.setCursor(0,20); display.print(F("WIPED!")); display.display(); delay(1000);
        }
      }
      saveConfigToSlot("default");
    }
  }

  if (btnPressed(BTN_IDX_BACK)) {
    if (isEditing) isEditing = false;
    else {
      if (currentCat == CAT_PROFILES || currentCat == CAT_GP_MENU || currentCat == CAT_MK_MENU || currentCat == CAT_SYS_CFG) { currentCat = CAT_MAIN; scrollIndex = 0; }
      else if (currentCat == CAT_GP_MAP || currentCat == CAT_GP_J1 || currentCat == CAT_GP_J2) { currentCat = CAT_GP_MENU; scrollIndex = 0; }
      else if (currentCat == CAT_KB_MAP || currentCat == CAT_MK_J1 || currentCat == CAT_MK_J2 || currentCat == CAT_MOUSE_CFG) { currentCat = CAT_MK_MENU; scrollIndex = 0; }
      else if (currentCat == CAT_PROF_SAVE_OPT || currentCat == CAT_LIST_LOAD || currentCat == CAT_LIST_OVERWRITE || currentCat == CAT_LIST_RENAME || currentCat == CAT_LIST_DELETE) { currentCat = CAT_PROFILES; scrollIndex = 0; }
    }
  }
  updateOLED(); 
}

