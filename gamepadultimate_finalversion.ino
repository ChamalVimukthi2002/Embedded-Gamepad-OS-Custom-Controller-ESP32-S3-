void printMenuRow(int idx, const char* title, const char* valStr, bool isBool = false) {
  if (idx == scrollIndex) display.print(isEditing ? F(" >[") : F(" > ")); else display.print(F("   "));
  display.print(title);
  if (valStr != nullptr) { if (isBool && idx == scrollIndex && isEditing) display.print(editValue ? F("TRUE") : F("FALSE")); else display.print(valStr); }
  if (idx == scrollIndex && isEditing) display.println(F("]")); else display.println();
}

void updateOLED() {
