// ==========================================
// TESTER, GAMEPAD, AND MOUSE LOGIC 
// ==========================================

void handleTester() {
  int j1x = analogRead(JOY1_X); int j1y = analogRead(JOY1_Y);
  int j2x = analogRead(JOY2_X); int j2y = analogRead(JOY2_Y);
  
  static unsigned long lastOledUpdate = 0;
  if (millis() - lastOledUpdate > 100) {
    display.clearDisplay(); display.setTextColor(SSD1306_WHITE); display.setTextSize(1); display.setCursor(0, 0);
    display.print(F("J1 X:")); display.print(j1x); display.print(F(" Y:")); display.println(j1y);
    display.print(F("J2 X:")); display.print(j2x); display.print(F(" Y:")); display.println(j2y);
    display.println(); display.println(F("Buttons Pressed:"));
    
    bool anyBtn = false;
    for (int i = 0; i < 13; i++) {
      if (buttonStates[i]) {
        display.print(F("[")); display.print(buttonPins[i]); display.print(F("]"));
        anyBtn = true;
      }
    }
    if (!anyBtn) display.print(F("NONE"));
    
    display.setCursor(0, 56); 
    display.print(F("Hold P")); display.print(buttonPins[BTN_IDX_MENU_1]); 
    display.print(F("+P")); display.print(buttonPins[BTN_IDX_MENU_2]); display.print(F("->EXIT")); 
    display.display();
    lastOledUpdate = millis();
  }
}

void handleGamepad() {
  int8_t j1x, j1y, j2x, j2y; 
  getJoystickStates(j1x, j1y, j2x, j2y, true);
  
  uint32_t buttons = 0; bool dUp=false, dDown=false, dLeft=false, dRight=false;
  int8_t triggerL = 0; int8_t triggerR = 0; 
  int8_t leftX = 0, leftY = 0, rightX = 0, rightY = 0;

  for (int i = 0; i < 13; i++) {
    if (buttonStates[i]) {
      uint32_t mapping = gpValues[gp_map_idx[i]];
      if (mapping == DPAD_UP) dUp = true; 
      else if (mapping == DPAD_DOWN) dDown = true; 
      else if (mapping == DPAD_LEFT) dLeft = true; 
      else if (mapping == DPAD_RIGHT) dRight = true;
      else {
        buttons |= mapping;
        if (mapping == BTN_L2) triggerL = 127; 
        if (mapping == BTN_R2) triggerR = 127;
      }
    }
  }
  
  if (gp_j1_mode == 0) { leftX = j1x; leftY = j1y; } 
  else if (gp_j1_mode == 1) { rightX = j1x; rightY = j1y; } 
  else if (gp_j1_mode == 2) { 
    if (j1y < -64) dUp = true; else if (j1y > 64) dDown = true;
    if (j1x < -64) dLeft = true; else if (j1x > 64) dRight = true;
  }

  if (gp_j2_mode == 0) { leftX = j2x; leftY = j2y; } 
  else if (gp_j2_mode == 1) { rightX = j2x; rightY = j2y; } 
  else if (gp_j2_mode == 2) { 
    if (j2y < -64) dUp = true; else if (j2y > 64) dDown = true;
    if (j2x < -64) dLeft = true; else if (j2x > 64) dRight = true;
  }
  
  uint8_t hat = 0; 
  if (dUp && dRight) hat = 2; else if (dDown && dRight) hat = 4; else if (dDown && dLeft) hat = 6; else if (dUp && dLeft) hat = 8;
  else if (dUp) hat = 1; else if (dRight) hat = 3; else if (dDown) hat = 5; else if (dLeft) hat = 7;
  
  // ANTI-SPAM LOGIC
  bool stateChanged = false;
  if (leftX != last_gp_j1x || leftY != last_gp_j1y || rightX != last_gp_j2x || rightY != last_gp_j2y ||
      triggerL != last_gp_trigL || triggerR != last_gp_trigR || hat != last_gp_hat || buttons != last_gp_btn) {
    stateChanged = true;
  }

  if (stateChanged) {
    if (conf_use_ble) {
      if (bleGamepad.isConnected()) {
        bleGamepad.setLeftThumb(map(leftX, -127, 127, -32767, 32767), map(leftY, -127, 127, -32767, 32767));
        bleGamepad.setRightThumb(map(rightX, -127, 127, -32767, 32767), map(rightY, -127, 127, -32767, 32767));
        bleGamepad.setLeftTrigger(triggerL > 0 ? 32767 : 0);
        bleGamepad.setRightTrigger(triggerR > 0 ? 32767 : 0);
        bleGamepad.setHat1(hat);
        for (int i=0; i<16; i++) {
          if (buttons & (1<<i)) bleGamepad.press(i+1);
          else bleGamepad.release(i+1);
        }
      }
    } else {
      Gamepad.send(leftX, leftY, rightX, rightY, triggerL, triggerR, hat, buttons);
    }
    last_gp_j1x = leftX; last_gp_j1y = leftY; last_gp_j2x = rightX; last_gp_j2y = rightY;
    last_gp_trigL = triggerL; last_gp_trigR = triggerR; last_gp_hat = hat; last_gp_btn = buttons;
  }
  
  // Update screen at a slower 2Hz to prevent display lag while gaming!
  if (millis() - lastOledUpdate > 500) {
    display.clearDisplay(); display.setTextColor(SSD1306_WHITE); 
    display.setTextSize(2); display.setCursor(0, 10); display.println(conf_use_ble ? F("BLEGAMEPAD") : F("USBGAMEPAD"));
    display.setTextSize(1); display.setCursor(0, 30); 
    if (conf_use_ble) display.println(bleGamepad.isConnected() ? F("Status: CONNECTED") : F("Status: PAIRING..."));
    display.setCursor(0, 48); 
    display.print(F("Hold P")); display.print(buttonPins[BTN_IDX_MENU_1]); 
    display.print(F(" & P")); display.println(buttonPins[BTN_IDX_MENU_2]); 
    display.println(F("to open OS Menu")); 
    display.display();
    lastOledUpdate = millis();
  }
}

void handleMouse() {
  if (conf_use_ble) {
    if (millis() - lastOledUpdate > 500) {
      display.clearDisplay(); display.setTextColor(SSD1306_WHITE); display.setTextSize(2);
      display.setCursor(0, 10); display.println(F("ERROR:"));
      display.setTextSize(1); display.setCursor(0, 30);
      display.println(F("M+K requires USB!")); display.println(F("Change connection")); display.println(F("in Main Menu.")); display.display();
      lastOledUpdate = millis();
    }
    return;
  }

   // THE FIX: Continuously send a neutral Gamepad heartbeat in the background
  // This tricks ZZZ into recognizing the controller while you navigate with the mouse!
  Gamepad.send(0, 0, 0, 0, 0, 0, 0, 0); 

  int8_t j1x, j1y, j2x, j2y; getJoystickStates(j1x, j1y, j2x, j2y, false); 
  float mouseMoveX = 0, mouseMoveY = 0;
  if (j1x != 0) { mouseMoveX = conf_mouse_sens * pow(abs((float)j1x) / 127.0, conf_mouse_accel); if (j1x < 0) mouseMoveX = -mouseMoveX; }
  if (j1y != 0) { mouseMoveY = conf_mouse_sens * pow(abs((float)j1y) / 127.0, conf_mouse_accel); if (j1y < 0) mouseMoveY = -mouseMoveY; }
  
  if (mouseMoveX != 0 || mouseMoveY != 0) {
    Mouse.move((int)mouseMoveX, (int)mouseMoveY, 0);
  }

  for (int i = 0; i < 13; i++) {
    uint8_t keyChar = kbValues[kb_map_idx[i]];
    if (keyChar != 0) {
      if (buttonStates[i] && !lastButtonStates[i]) {
        if (keyChar == CMD_M_LEFT) Mouse.press(MOUSE_LEFT);
        else if (keyChar == CMD_M_RIGHT) Mouse.press(MOUSE_RIGHT);
        else if (keyChar == CMD_M_MID) Mouse.press(MOUSE_MIDDLE);
        else Keyboard.press(keyChar);
      }
      if (!buttonStates[i] && lastButtonStates[i]) {
        if (keyChar == CMD_M_LEFT) Mouse.release(MOUSE_LEFT);
        else if (keyChar == CMD_M_RIGHT) Mouse.release(MOUSE_RIGHT);
        else if (keyChar == CMD_M_MID) Mouse.release(MOUSE_MIDDLE);
        else Keyboard.release(keyChar);
      }
    }
  }

  if (mk_j2_mode > 0) {
    uint8_t upKey = 0, downKey = 0, leftKey = 0, rightKey = 0;
    if (mk_j2_mode == 1) { upKey=KEY_UP_ARROW; downKey=KEY_DOWN_ARROW; leftKey=KEY_LEFT_ARROW; rightKey=KEY_RIGHT_ARROW; }
    else if (mk_j2_mode == 2) { upKey='w'; downKey='s'; leftKey='a'; rightKey='d'; }
    bool jUp = (j2y < -64); bool jDown = (j2y > 64); bool jLeft = (j2x < -64); bool jRight = (j2x > 64);
    static bool ljUp=false, ljDown=false, ljLeft=false, ljRight=false;
    if(jUp && !ljUp) Keyboard.press(upKey); if(!jUp && ljUp) Keyboard.release(upKey);
    if(jDown && !ljDown) Keyboard.press(downKey); if(!jDown && ljDown) Keyboard.release(downKey);
    if(jLeft && !ljLeft) Keyboard.press(leftKey); if(!jLeft && ljLeft) Keyboard.release(leftKey);
    if(jRight && !ljRight) Keyboard.press(rightKey); if(!jRight && ljRight) Keyboard.release(rightKey);
    ljUp = jUp; ljDown = jDown; ljLeft = jLeft; ljRight = jRight;
  }

  if (millis() - lastOledUpdate > 500) {
    display.clearDisplay(); display.setTextColor(SSD1306_WHITE); display.setTextSize(2); display.setCursor(0, 10); display.println(F("MOUSE+KEYS"));
    display.setTextSize(1); display.setCursor(0, 40); 
    display.print(F("Hold P")); display.print(buttonPins[BTN_IDX_MENU_1]); 
    display.print(F(" & P")); display.println(buttonPins[BTN_IDX_MENU_2]); 
    display.println(F("to open OS Menu")); 
    display.display();
    lastOledUpdate = millis();
  }
}